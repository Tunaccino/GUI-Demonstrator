  <property name="windowTitle">
   <string>ATHENE – Motor Controller</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* DARE ROBOTICS, Eloxal-Grund wie auf den Folien.
   Eloxal 900 #22262D  700 #535A66  500 #686F7A  300 #9DA4AE  100 #DEE1E6
   Kapton 300 #E3B64D  500 #CC9300  600 #A87A00
   Schriften setzt controller.cpp (Stylesheets koennen keine Fallback-Liste). */
QDialog {
    background: #22262D;
}
QLabel {
    color: #DEE1E6;
    background: transparent;
}
QLabel[role=&quot;tagline&quot;] {
    color: #CC9300;
}
/* Karten wie auf der Folie &quot;Kein Papierprojekt&quot;: feine Kontur, goldene Kante links */
QFrame[role=&quot;card&quot;] {
    background: #22262D;
    border: 1px solid #535A66;
    border-left: 4px solid #CC9300;
}
QLabel[role=&quot;cardTitle&quot;] {
    color: #CC9300;
}
QLabel[role=&quot;caption&quot;] {
    color: #9DA4AE;
}
QLabel[role=&quot;readout&quot;], QLabel[role=&quot;hero&quot;] {
    color: #FFFFFF;
}
QLabel[role=&quot;unit&quot;] {
    color: #9DA4AE;
}
QLabel[role=&quot;fieldLabel&quot;] {
    color: #FFFFFF;
}
/* Grobmodus (x10) nach Druck auf den Drehgeber */
QLabel[role=&quot;fieldLabel&quot;][coarse=&quot;true&quot;] {
    color: #CC9300;
}
/* Nummer des Drehgebers, wie die Achsnummern auf der Folie &quot;Jede Achse anders gebaut&quot; */
QLabel[role=&quot;badge&quot;] {
    background: #CC9300;
    color: #22262D;
    border-radius: 13px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}
QFrame[role=&quot;rule&quot;] {
    background: #535A66;
    border: none;
    min-height: 1px;
    max-height: 1px;
}
/* Farbmuster vor den Messwerten, gleiche Farben wie die Kurven im Plot */
QFrame[role=&quot;swatch&quot;] {
    border: none;
    min-width: 14px;
    max-width: 14px;
    min-height: 3px;
    max-height: 3px;
}
QFrame#swatchPosition { background: #FFFFFF; }
/* Plot im Goldrahmen, wie die Fotos auf den Folien */
QFrame#plotFrame {
    background: #22262D;
    border: 3px solid #CC9300;
}
QLineEdit {
    background: #22262D;
    color: #FFFFFF;
    border: 1px solid #686F7A;
    border-radius: 0px;
    padding: 6px 10px;
    min-width: 64px;
    min-height: 22px;
    selection-background-color: #CC9300;
    selection-color: #22262D;
}
QLineEdit:hover {
    border: 1px solid #9DA4AE;
}
/* Der Drehgeber setzt den Fokus: so sieht man, welcher Wert sich gerade aendert */
QLineEdit:focus {
    border: 1px solid #CC9300;
    background: rgba(204, 147, 0, 0.12);
}
/* PID-Werte gross, damit man sie auch aus ein paar Metern lesen kann */
QLineEdit[role=&quot;pidValue&quot;] {
    padding: 2px 14px;
    min-height: 44px;
}
QGraphicsView {
    background: #22262D;
    border: none;
}</string>
  </property>
