   <string notr="true">QDialog {
    background: #22262D;
}

QLabel {
    color: #9DA4AE;
    font-size: 13px;
}

QLabel[valueField=&quot;true&quot;] {
    color: #FFFFFF;
    font-size: 13px;
    background: #22262D;
    border: none;
    border-left: 2px solid #CC9300;
    border-radius: 0px;
    padding: 6px 12px;
    min-width: 130px;
    min-height: 18px;
}

QGroupBox {
    color: #CC9300;
    font-size: 12px;
    border: 1px solid #535A66;
    border-radius: 0px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0px 6px;
}

QLineEdit {
    background: #22262D;
    color: #FFFFFF;
    border: 1px solid #686F7A;
    border-radius: 0px;
    padding: 8px 12px;
    min-width: 150px;
    min-height: 20px;
    selection-background-color: #CC9300;
    selection-color: #22262D;
}

QLineEdit:hover {
    border: 1px solid #9DA4AE;
}

QLineEdit:focus {
    border: 1px solid #CC9300;
}

QPushButton {
    background: #CC9300;
    color: #22262D;
    border: none;
    border-radius: 0px;
    padding: 9px 24px;
    font-size: 13px;
}

QPushButton:hover {
    background: #E3B64D;
}

QPushButton:pressed {
    background: #A87A00;
}

QPushButton#resetButton, QPushButton#demoButton {
    background: transparent;
    color: #DEE1E6;
    border: 1px solid #686F7A;
}

QPushButton#resetButton:hover, QPushButton#demoButton:hover {
    background: #535A66;
    border: 1px solid #9DA4AE;
}

QGraphicsView {
    background: #22262D;
    border: 1px solid #535A66;
    border-radius: 0px;
}</string>
